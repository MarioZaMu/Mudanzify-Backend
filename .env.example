# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Frontend dev server used by `npm run dev` (mudanzify-frontend).
FRONTEND_DEV_URL=http://localhost:5173

# Path to the frontend repo, used by `npm run renderer:copy`.
FRONTEND_DIR=../mudanzify-frontend

# Google Gemini API key for the AI interview (free, no card): https://aistudio.google.com/apikey
# Without a key the app runs in demo mode with scripted questions.
GEMINI_API_KEY=

# Optional: model id (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite
