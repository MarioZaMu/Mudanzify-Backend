# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Frontend dev server used by `npm run dev` (mudanzify-frontend).
FRONTEND_DEV_URL=http://localhost:5173

# Path to the frontend repo, used by `npm run renderer:copy`.
FRONTEND_DIR=../mudanzify-frontend

# AI provider key (defined in phase 5).
# AI_API_KEY=
